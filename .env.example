# Browser requests stay on the frontend origin; Next.js proxies /api/* to this backend.
# In Vercel production set BACKEND_INTERNAL_API_URL to the backend production
# alias, including /api (for example https://chezharneet-backend.vercel.app/api).
NEXT_PUBLIC_API_URL=/api
BACKEND_INTERNAL_API_URL=http://127.0.0.1:4000/api
